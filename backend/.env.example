PORT=4000

# true = lewati login password (gunakan hanya untuk development lokal).
AUTH_DISABLED=false

# Password login aplikasi dan secret penandatangan session.
# SESSION_SECRET wajib berupa nilai acak minimal 32 karakter.
APP_PASSWORD=ganti_dengan_password_yang_kuat
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# true = gunakan backend/sample-data/projects.json tanpa Google Sheets.
# Cocok untuk development dan testing lokal.
USE_SAMPLE_DATA=true
SAMPLE_DATA_PATH=sample-data/projects.json

# Ambil dari file JSON Service Account (lihat README bagian setup)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_PRIVATE_KEY_DISINI\n-----END PRIVATE KEY-----\n"

# ID spreadsheet: ambil dari URL-nya
# https://docs.google.com/spreadsheets/d/INI_ID_NYA/edit
SPREADSHEET_ID=isi_spreadsheet_id_disini

# Range sheet yang berisi data (nama sheet + rentang kolom)
SHEET_RANGE=Sheet1!A1:I1000

# Path ke template docx yang dipakai untuk generate dokumen
TEMPLATE_PATH=templates/ba-drop-template.docx

# HANYA DIISI kalau convert ke PDF error / soffice tidak ketemu otomatis
# (umumnya perlu di Windows kalau LibreOffice diinstall ke folder custom).
# Contoh Windows: C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_PATH=
